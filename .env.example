# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value is optional: docker-compose.yml applies
# the same defaults inline, so the stack boots without this file.
#     cp .env.example .env
#
# NEVER commit a populated .env - it is in .gitignore.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# json = structured single-line logs (production), text = human readable (local)
LOG_FORMAT=json
API_PORT=8000

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=sentiment.exchange
RABBITMQ_QUEUE=sentiment.jobs
RABBITMQ_ROUTING_KEY=sentiment.analyze
RABBITMQ_DEAD_LETTER_EXCHANGE=sentiment.dlx
RABBITMQ_DEAD_LETTER_QUEUE=sentiment.jobs.dlq
# Unacknowledged messages allowed per worker channel.
RABBITMQ_PREFETCH_COUNT=8
# Images (optional pinning)
RABBITMQ_IMAGE_TAG=3.13-management-alpine

# --- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb://mongodb:27017/sentiment_db
MONGO_DB_NAME=sentiment_db
MONGO_COLLECTION=sentiment_results
MONGODB_PORT=27017
MONGODB_IMAGE_TAG=7.0

# --- Model ------------------------------------------------------------------
MODEL_PATH=app/models/sentiment_model.h5
WORD_INDEX_PATH=app/models/word_index.json
MODEL_METADATA_PATH=app/models/model_metadata.json
# Score at or above which a sample is labelled positive.
POSITIVE_THRESHOLD=0.5

# --- Worker -----------------------------------------------------------------
WORKER_MAX_RETRIES=3
WORKER_HEARTBEAT_PATH=/tmp/sentiment-worker/heartbeat.json
WORKER_HEARTBEAT_STALE_SECONDS=60

# --- TensorFlow tuning ------------------------------------------------------
# 0 keeps the library default. Lower these if the container is CPU-limited.
TF_INTRA_OP_THREADS=0
TF_INTER_OP_THREADS=0
TF_ENABLE_GPU=false
